# Never commit real credentials. This file documents runtime variables only.

# Current trusted-LAN TrueNAS runtime settings. Client IDs are not secrets.
NEWS_PLAYLIST_ADMIN_MODE=lan
NEWS_PLAYLIST_ADMIN_PASSWORD_FILE=/data/admin-password
NEWS_PLAYLIST_CONFIG=
NEWS_PLAYLIST_INTERVAL_SECONDS=600
SPOTIFY_CLIENT_ID=

# Optional hardened HTTPS/reverse-proxy mode only; do not set these in LAN mode.
NEWS_PLAYLIST_EXTERNAL_URL=
NEWS_PLAYLIST_TRUSTED_PROXY_CIDRS=

# P0/advanced diagnostic path only; do not persist or commit access tokens.
SPOTIFY_ACCESS_TOKEN=
SPOTIFY_PROBE_WRITE=0
